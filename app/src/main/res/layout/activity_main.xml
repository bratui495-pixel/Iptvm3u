<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player Video Fullscreen -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- Buton Deschidere / Inchidere Lista (Colt stanga-sus) -->
    <Button
        android:id="@+id/btnToggleList"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:backgroundTint="#99000000"
        android:text="☰ Canale"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Panou Lateral Canale (Stil Smart IPTV) -->
    <LinearLayout
        android:id="@+id/sidebarPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#CC111111"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#1E1E1E">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Listă Canale TV"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLoadUrl"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Link"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnLoadFile"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Fişier"
                android:textSize="11sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:background="#2A2A2A"
            android:hint="Caută canal..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="13sp"
            android:paddingHorizontal="10dp" />

        <ListView
            android:id="@+id/channelListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#252525"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- OSD Bar jos (Afisat la tap pe ecran) -->
    <LinearLayout
        android:id="@+id/osdBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0A0A0A"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCurrentChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Niciun canal redat"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAspectRatio"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#333333"
            android:text="Imagine: Fit"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#333333"
            android:text="Volum / Lumină"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Panou Plutitor Setări Volum și Luminozitate -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#EE1E1E1E"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setări Imagine &amp; Sunet"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volum Sistem:"
            android:textColor="#CCCCCC"
            android:textSize="12sp"/>

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Luminozitate Ecran:"
            android:textColor="#CCCCCC"
            android:textSize="12sp"/>

        <SeekBar
            android:id="@+id/seekBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="50"/>

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Închide"
            android:textSize="12sp"/>
    </LinearLayout>

</FrameLayout>
